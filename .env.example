# ============================================
# DMShop — Variables de Entorno
# ============================================
# Copiar este archivo a .env y configurar los valores

# --- Aplicación ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
ADMIN_URL=http://localhost:4300

# --- Base de Datos (MySQL / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dmshop
DB_USER=root
DB_PASS=

# --- JWT ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dmshop.com
SMTP_FROM_NAME=DMShop
SMTP_FROM_EMAIL=noreply@dmshop.com

# --- PayPal ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# --- Archivos ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Logging ---
LOG_LEVEL=debug
LOG_DIR=logs
